{
  "name": "mypackages.dev",
  "private": true,
  "version": "0.0.0",
  "description": "",
  "homepage": "https://mypackages.dev",
  "bugs": {
    "url": "https://github.com/phun-ky/mypackages.dev/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/mypackages.dev.git"
  },
  "license": "MIT",
  "author": "Alexander Vassbotn Røyne-Helgesen",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0 && node scripts/check-colours.mjs",
    "format:check": "prettier --check .",
    "check:metadata": "node scripts/check-metadata.mjs",
    "images:logo": "node scripts/logo/render.mjs",
    "images:og": "node scripts/og/render.mjs",
    "typecheck": "tsc",
    "test:unit": "node --import tsx --enable-source-maps --test \"tests/unit/**/*.test.ts\"",
    "test:coverage": "node --import tsx --enable-source-maps --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=90 --test-coverage-branches=85 --test-coverage-functions=95 --test \"tests/unit/**/*.test.ts\"",
    "pretest:e2e": "vite build --mode e2e",
    "test:e2e": "playwright test",
    "commit": "npx git-cz",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-phun-ky": "^2.0.10",
    "fast-check": "^4.10.2",
    "git-cz": "^4.9.0",
    "globals": "^17.13.0",
    "html-validate": "^11.17.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/lexend-deca": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "diff-dom": "^5.2.1",
    "dompurify": "^3.4.17",
    "highcharts": "^13.1.1",
    "marked": "^18.1.1"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "^0.18.2"
    }
  }
}
